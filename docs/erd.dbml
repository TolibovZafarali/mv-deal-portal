}

Table investor_favorites {
  id bigint [pk, increment]
  investor_id bigint [not null, ref: > investors.id]
  property_id bigint [not null, ref: > properties.id]
  created_at datetime [not null]

  indexes {
    (investor_id, property_id) [unique]
  }
}

Table email_events {
  id bigint [pk, increment]
  record_type varchar(50) [not null]
  recipient_email varchar(255)
  postmark_message_id varchar(120)
  postmark_message_stream varchar(120)
